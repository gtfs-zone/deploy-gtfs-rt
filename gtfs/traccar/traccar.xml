<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE properties SYSTEM 'http://java.sun.com/dtd/properties.dtd'>
<!--
  Traccar configuration, ported from music-student's dev/traccar/traccar.xml.

  Secrets are deliberately ABSENT from this file: the Deployment sets
  CONFIG_USE_ENVIRONMENT_VARIABLES=true, so DATABASE_PASSWORD and
  OPENID_CLIENT_SECRET arrive as env vars from Secrets and override anything here.
  (Verified against traccar/traccar:6.14.5; env wins over the XML for every key,
  including database.url/user/password.)

  The env-name mapping is NOT simply "uppercase and drop the dots": Traccar
  inserts an underscore before each capital letter first, so a camelCase config
  key gains a separator:
      database.password   -> DATABASE_PASSWORD      (no capitals; unchanged)
      openid.clientSecret -> OPENID_CLIENT_SECRET   (note the extra underscore)
  Verified in-cluster: with OPENID_CLIENTSECRET the value never reaches Traccar
  and every /api/server call 500s on a null clientSecret.

  NOTE: the server-settings "registration" flag (DB-backed, not a config key)
  must stay OFF, or the public sign-up form bypasses the OIDC group gate below.
  openid.allowRegistration is what still lets an allowed OIDC login provision
  itself.
-->
<properties>
    <entry key='database.driver'>org.postgresql.Driver</entry>
    <entry key='database.url'>jdbc:postgresql://postgres-rw:5432/traccar</entry>
    <entry key='database.user'>traccar</entry>

    <entry key='web.url'>https://traccar.gtfs.zone</entry>

    <!-- Keycloak, not Dex. Traccar is NOT behind oauth2-proxy; it is a
         separate OIDC client with its own login, so it has to be repointed in
         the same cutover or its console login breaks silently while the pod
         stays healthy. -->
    <entry key='openid.clientId'>traccar</entry>
    <entry key='openid.issuerUrl'>https://id.gtfs.zone/realms/gtfs</entry>

    <!-- Traccar is admin-only. allowGroup is the gate: a realm account outside
         gtfs-admins is refused at the callback and never gets a Traccar user at
         all. adminGroup then makes the ones who pass Traccar administrators, so
         they see every device without the per-user POST /api/permissions share.

         Both read the `groups` claim (openid.groupsClaimName defaults to it).
         Keycloak's `groups` client scope maps with full.path=false, so the claim
         value is the bare name; a leading slash here would match nothing and
         lock everyone out. The scope is a DEFAULT scope on the traccar client,
         so it rides along without Traccar asking for it.

         openid.force is deliberately NOT set: the local password login stays as
         break-glass, and cafe-car's REST API session login (TRACCAR_EMAIL /
         TRACCAR_PASSWORD) keeps working. allowGroup only gates the OIDC path. -->
    <entry key='openid.allowGroup'>gtfs-admins</entry>
    <entry key='openid.adminGroup'>gtfs-admins</entry>

    <!-- Auto-create the Traccar user for an OIDC login that passed allowGroup,
         even though the server's own "registration" setting is off. That pairing
         is the point: the public sign-up form is closed, but group members still
         provision themselves on first login. Turning registration back on in the
         server settings would reopen the form and undo the gate above. -->
    <entry key='openid.allowRegistration'>true</entry>

    <!-- Forward each position to the vehicle-poser HTTP shim, which resolves the
         tracker's trip via railroad-club and writes the vehicle:{tracker_id}:{deviceId}
         Redis record that cafe-car reads. Do NOT switch this to forward.type=redis:
         that LPUSHes raw Position JSON (unbounded list, no TTL, no trip_id). -->
    <entry key='forward.enable'>true</entry>
    <entry key='forward.type'>json</entry>
    <entry key='forward.url'>http://vehicle-poser:8080/forward</entry>
    <entry key='forward.retry.enable'>true</entry>
</properties>
