# ── Required ──────────────────────────────────────────────────────────────────

domain    = "gtfs.example.com"
server_ip = "1.2.3.4"

# ── OAuth connector credentials ───────────────────────────────────────────────
# Each block is optional — omit entirely to disable that Dex connector.
# Authorization callback URL for all providers: https://dex.<domain>/callback

# GitHub — https://github.com/settings/developers → OAuth Apps
github_oauth = {
  client_id     = "Iv1...."
  client_secret = "..."
}

# GitLab — https://gitlab.com/-/profile/applications (or self-hosted)
# gitlab_oauth = {
#   client_id     = "..."
#   client_secret = "..."
#   base_url      = "https://gitlab.com"  # omit for default
#   groups        = []                    # omit to allow all groups
# }

# Google — https://console.cloud.google.com/apis/credentials
# google_oauth = {
#   client_id      = "....apps.googleusercontent.com"
#   client_secret  = "..."
#   hosted_domains = []  # omit to allow all domains
# }

# ── DNS credentials (Porkbun) ─────────────────────────────────────────────────

porkbun_api_key        = "pk1_..."
porkbun_secret_api_key = "sk1_..."

# ── Optional infrastructure ───────────────────────────────────────────────────

# Remote Docker host over SSH. Omit (or set to null) to use the local socket.
# docker_host = "ssh://myserver"

# Prefix prepended to all container, volume, and network names.
# Useful if sharing a Docker host with another stack.
# name_prefix = "gtfs"

# ── Private registry credentials ──────────────────────────────────────────────
# Required to pull images from git.kcfam.us.

# registry_username = "myuser"
# registry_password = "mytoken"

# ── Subdomain overrides ───────────────────────────────────────────────────────
# Defaults shown — uncomment to override.

# auth_subdomain    = "auth"
# dex_subdomain     = "dex"
# api_subdomain     = "api"
# uptime_subdomain  = "uptime"
# status_subdomain  = "status"
# mqtt_subdomain    = "mqtt"
# mqtt_ws_subdomain = "ws.mqtt"

# ── External Traefik ──────────────────────────────────────────────────────────
# Set use_external_traefik = true to skip deploying Traefik and instead attach
# all proxy-facing containers to an already-running Traefik's network.
# The external Traefik must have a cert resolver whose name matches
# traefik_cert_resolver (default: "letsencrypt").

# use_external_traefik     = true
# external_traefik_network = "proxy-tier"
# traefik_cert_resolver    = "letsencrypt"

# ── Celery ────────────────────────────────────────────────────────────────────
# Defaults shown — uncomment to override.

# celery_worker_concurrency  = 2   # worker processes; lower = less RAM
# celery_max_tasks_per_child = 10  # recycle workers after N tasks to limit memory growth

# ── Image versions ────────────────────────────────────────────────────────────
# Defaults shown — uncomment to pin.

# traefik_version        = "v3.6"
# redis_version          = "8.6-alpine"
# postgres_version       = "18.3-alpine"
# oauth2_proxy_version   = "latest"
# dex_version            = "latest"
# nanomq_version         = "latest"
# uptime_kuma_version    = "latest"
# cafe_car_tag           = "latest"
# vehicle_poser_tag      = "latest"
# trip_updogger_tag      = "latest"
# schedule_foamer_tag    = "latest"
